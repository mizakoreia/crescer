# Copie para .env (local) OU cadastre no painel do Vercel (produção).
# Estas variáveis são embutidas no bundle no MOMENTO DO BUILD.
# Encontre os valores em: Supabase → Settings → API.

EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica

# Somente para as Edge Functions (NÃO vai no app / não é EXPO_PUBLIC).
# Cadastre com: supabase secrets set ANTHROPIC_API_KEY=...
# ANTHROPIC_API_KEY=sk-ant-...
